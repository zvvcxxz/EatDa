<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sp.app.admin.mapper.AdminHomeMapper">
	
	<select id="memberCount" resultType="Integer">
		SELECT COUNT(*) FROM MEMBER
	</select>
	
	<select id="recipeCount" resultType="Integer">
		SELECT COUNT(*) FROM RECIPE
	</select>
	
	<select id="pendingReportCount" resultType="Integer">
		SELECT COUNT(*) FROM REPORT WHERE STATUS = 0
	</select>
	
	<select id="pendingInquiryCount" resultType="Integer">
		SELECT COUNT(*) FROM INQUIRY WHERE STATUS = 0
	</select>

</mapper>